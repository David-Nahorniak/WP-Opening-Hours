<?xml version="1.0"?>
<ruleset name="WP Opening Hours Security">
    <description>Security-focused coding standard for WP Opening Hours (WordPress.Security escape/sanitize/nonce sniffs).</description>

    <!-- Scan the plugin code, excluding vendored and test template assets. -->
    <file>classes/</file>
    <file>views/</file>
    <file>functions.php</file>
    <file>run.php</file>
    <file>wp-opening-hours.php</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/includes/*</exclude-pattern>

    <!-- Use the WordPress coding standard as the base. -->
    <rule ref="WordPress"/>

    <!-- Require the security-specific sniffs to be clean (Fáze 6.1). -->
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.Security.NonceVerification"/>

    <config name="testVersion" value="7.4-"/>
</ruleset>