{
  "name": "janizde/wp-opening-hours",
  "description": "WordPress Plugin for Opening Hours management",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "Jannik Portz",
      "email": "hello@jannikportz.de"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "4.8.*",
    "10up/wp_mock": "^0.1.1",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^2.3",
    "pheromone/phpcs-security-audit": "^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=phpcs.xml.dist"
  },
  "autoload-dev": {
    "psr-4": {
      "OpeningHours\\": "classes/OpeningHours",
      "OpeningHours\\Test\\": "tests/OpeningHours"
    }
  }
}
